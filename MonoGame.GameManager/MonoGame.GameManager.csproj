<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MonoGame.GameManager</RootNamespace>
    <AssemblyName>MonoGame.GameManager</AssemblyName>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Existing public members are documented progressively; do not fail the build on missing XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>MonoGame.GameManager</PackageId>
    <Version>2.0.0</Version>
    <Authors>Danilo Peres</Authors>
    <Description>MonoGame.GameManager is a library to manage the components you need to create a 2D game with MonoGame: screens and transitions, UI controls, animations and tweens, timers, input (mouse, touch, keyboard and gamepad), a 2D camera, collision helpers, particles, audio and save games.</Description>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/DaniloPeres/MonoGame.GameManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DaniloPeres/MonoGame.GameManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>MonoGame;GameEngine;2D;UI;Screens;Animations;Tween;Input;Camera;Particles</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>See https://github.com/DaniloPeres/MonoGame.GameManager/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only reference: every game references its own MonoGame platform package (DesktopGL, WindowsDX, Android, iOS...). -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <!-- Temporary: removed together with the Generic Host based service locator. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Logo.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
