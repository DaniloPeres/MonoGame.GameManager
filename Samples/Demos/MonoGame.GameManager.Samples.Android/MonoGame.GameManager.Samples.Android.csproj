<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.daniloperes.gamemanager.samples</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RootNamespace>MonoGame.GameManager.Samples.Android</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AndroidStoreUncompressedFileExtensions>.m4a</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.ShaderEffects" Version="1.0.3" />
    <!-- The stroke shader is embedded in the assembly; its loose DesktopGL content file is not needed on Android. -->
    <PackageReference Include="MonoGame.StrokeEffect" Version="1.1.1" ExcludeAssets="contentFiles" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\MonoGame.GameManager\MonoGame.GameManager.csproj" />
  </ItemGroup>
  <Import Project="..\MonoGame.GameManager.Samples.Shared\MonoGame.GameManager.Samples.Shared.projitems" Label="Shared" />
  <!--
    The Android SDK runs one inner build per runtime identifier, in parallel, to collect the assemblies.
    Those builds would all run mgcb on the same folders and lock its files: build the content only once, in the outer build.
  -->
  <PropertyGroup Condition="'$(_ComputeFilesToPublishForRuntimeIdentifiers)' == 'true'">
    <EnableMGCBItems>false</EnableMGCBItems>
  </PropertyGroup>
  <ItemGroup Condition="'$(_ComputeFilesToPublishForRuntimeIdentifiers)' == 'true'">
    <MonoGameContentReference Remove="@(MonoGameContentReference)" />
  </ItemGroup>
</Project>
